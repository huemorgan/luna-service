# luna-service — environment variables
#
# Copy to .env, fill in. NEVER commit .env.
#
# Many values can be reused from existing projects. The "source" comment on each
# line tells you where to copy from:
#   • luna/.env                  → ../luna/.env (sibling luna submodule's env)
#   • luna-dojo                  → ../../luna-dojo/luna/.env
#   • Render runluna dashboard   → Render → runluna service → Environment tab
#   • Render luna-db dashboard   → Render → luna-db database → Connect tab
#   • new                        → create fresh for luna-service

# ────────────────────────────────────────────────────────────────────────────
# Control plane (cloud/)
# ────────────────────────────────────────────────────────────────────────────

CLOUD_ENV=dev                          # dev | staging | production
CLOUD_IDENTITY_PROVIDER=stub           # stub for dev, google for staging/prod
CLOUD_RUNTIME=docker-local             # docker-local for dev, fly-machines for prod

# Session signing — generate fresh, never commit
# source: new — run `python -c "import secrets; print(secrets.token_urlsafe(48))"`
CLOUD_SESSION_SECRET=

# Per-tenant vault key derivation root — generate fresh, never rotate without re-encryption
# source: new — run `python -c "import secrets; print(secrets.token_hex(32))"`
CLOUD_VAULT_ROOT_KEY=

# Shared secret between control plane (sender) and Luna instances (receiver)
# source: new — generate once, set the same value on both sides
CLOUD_TRUSTED_PROXY_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Databases
# ────────────────────────────────────────────────────────────────────────────

# Control-plane DB (users, accounts, agents, audit)
# source: local docker compose for dev; Render `luna-service-control` Postgres in prod
CLOUD_DATABASE_URL=postgresql+asyncpg://luna:luna@localhost:5432/luna_service_cp

# Tenant DB (per-tenant schemas with conversations, memory, vault)
# Admin connection string — used by control plane to CREATE SCHEMA / CREATE ROLE
# source: local docker compose for dev; Render `luna-tenant-prod` Postgres in prod
CLOUD_TENANT_DATABASE_URL=postgresql+asyncpg://luna:luna@localhost:5432/luna_tenants

# Tenant DB host (used to construct per-tenant connection strings handed to Luna machines)
CLOUD_TENANT_DB_HOST=localhost

# ────────────────────────────────────────────────────────────────────────────
# Google OAuth (Novalystrix Workspace)
# ────────────────────────────────────────────────────────────────────────────

# source: new — Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# (create inside the novalystrix.ai Workspace org)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# GitHub (version check — reads luna/__init__.py from huemorgan/luna)
# ────────────────────────────────────────────────────────────────────────────

# source: new — GitHub → Settings → Developer settings → Fine-grained tokens
# Permissions: Contents (read-only), scope: huemorgan/luna
GITHUB_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# Fly.io (phase 004)
# ────────────────────────────────────────────────────────────────────────────

# source: new — fly.io → Tokens → Create deploy token (scope: app:luna-tenants-prod)
FLY_API_TOKEN=
FLY_APP_NAME=luna-tenants-prod

# ────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 (phase 004)
# ────────────────────────────────────────────────────────────────────────────

# source: new — Cloudflare dashboard → R2 → Create bucket, then API token
R2_ENDPOINT=
R2_BUCKET=luna-service-prod
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ────────────────────────────────────────────────────────────────────────────
# LLM provider keys (passed through to provisioned Lunas — we own the bill)
# ────────────────────────────────────────────────────────────────────────────

# source: luna/.env or luna-dojo/luna/.env (already have these from prior work)
LUNA_ANTHROPIC_API_KEY=
LUNA_OPENAI_API_KEY=
LUNA_GEMINI_API_KEY=
LUNA_OPENROUTER_API_KEY=

# source: luna/.env (already have it)
LUNA_TAVILY_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Luna hosted-mode image (phase 001)
# ────────────────────────────────────────────────────────────────────────────

LUNA_HOSTED_IMAGE_TAG=luna-hosted:dev-001

# ────────────────────────────────────────────────────────────────────────────
# Notes on secrets we DON'T need to add to luna-service
# ────────────────────────────────────────────────────────────────────────────
#
# • LUNA_VAULT_MASTER_KEY — NOT a global env var anymore. The control plane derives
#   a unique key per tenant from CLOUD_VAULT_ROOT_KEY + account_id and passes it
#   to each Luna instance at provisioning time.
#
# • LUNA_OWNER_USERNAME / LUNA_OWNER_PASSWORD — gone in trusted-proxy mode.
#   Identity comes from the X-Luna-User header instead.
#
# • LUNA_JWT_SECRET — Luna's own JWT auth is bypassed in trusted-proxy mode.
#
# • Render DB connection strings, internal URLs — set automatically by render.yaml
#   via fromDatabase / fromService references when deployed.
